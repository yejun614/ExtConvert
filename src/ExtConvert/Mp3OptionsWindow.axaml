<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExtConvert.Mp3OptionsWindow"
        Title="MP3 저장 옵션"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12" MinWidth="280">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="비트레이트" VerticalAlignment="Center" />
      <ComboBox x:Name="BitrateBox" MinWidth="140" />
    </StackPanel>
    <TextBlock Text="높을수록 음질이 좋고 파일이 커집니다. (일반적으로 192 kbps)"
               FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="300" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="저장" IsDefault="True" Click="OnOkClick" MinWidth="72" HorizontalContentAlignment="Center" />
      <Button Content="취소" IsCancel="True" Click="OnCancelClick" MinWidth="72" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>

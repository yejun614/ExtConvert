<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExtConvert.IcoOptionsWindow"
        Title="ICO 저장 옵션"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12" MinWidth="280">
    <TextBlock Text="아이콘에 포함할 크기를 선택하세요." />
    <WrapPanel x:Name="SizePanel" MaxWidth="300" />
    <TextBlock x:Name="HintText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="300" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="저장" IsDefault="True" Click="OnOkClick" MinWidth="72" HorizontalContentAlignment="Center" />
      <Button Content="취소" IsCancel="True" Click="OnCancelClick" MinWidth="72" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>

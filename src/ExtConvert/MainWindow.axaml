<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ExtConvert.Controls"
        x:Class="ExtConvert.MainWindow"
        Title="Ext Convert"
        Width="480" Height="420"
        MinWidth="320" MinHeight="280"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <!-- 투명 영역을 보여주기 위한 체커보드 배경 -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" DestinationRect="0,0,16,16">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
          <GeometryDrawing Brush="#E0E0E0" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <StreamGeometry x:Key="PlayGeometry">M0,0 L10,6 L0,12 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseGeometry">M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z</StreamGeometry>
    <StreamGeometry x:Key="VolumeGeometry">M0,4 H3 L7,0 V12 L3,8 H0 Z M9,4.5 H10.2 V7.5 H9 Z M11.5,2.5 H12.7 V9.5 H11.5 Z</StreamGeometry>
    <StreamGeometry x:Key="MutedGeometry">M0,4 H3 L7,0 V12 L3,8 H0 Z M8.6,4.4 L9.4,3.6 L14,8.2 L13.2,9 Z M8.6,8.2 L13.2,3.6 L14,4.4 L9.4,9 Z</StreamGeometry>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="파일(_F)">
        <MenuItem x:Name="OpenMenuItem" Header="열기(_O)..." InputGesture="Ctrl+O" Click="OnOpenClick" />
        <MenuItem x:Name="SaveAsMenuItem" Header="다른 이름으로 저장(_A)..."
                  InputGesture="Ctrl+Shift+S" Click="OnSaveAsClick" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="CloseFileMenuItem" Header="닫기(_C)" Click="OnCloseFileClick" />
        <MenuItem Header="끝내기(_X)" Click="OnExitClick" />
      </MenuItem>
      <!-- 하위 항목은 Exporters 목록으로 코드에서 만들고, 열린 파일에 따라 활성화한다 -->
      <MenuItem x:Name="ConvertMenu" Header="변환(_V)">
        <MenuItem x:Name="ImageConvertMenu" Header="이미지(_I)" />
        <MenuItem x:Name="VideoConvertMenu" Header="동영상(_D)" />
        <MenuItem x:Name="AudioConvertMenu" Header="오디오(_U)" />
        <Separator />
        <MenuItem x:Name="RangeModeMenuItem" Header="선택 구간만 변환(_R)" ToggleType="CheckBox"
                  Click="OnRangeModeMenuClick" />
        <MenuItem x:Name="CropModeMenuItem" Header="선택 영역만 변환(_E)" ToggleType="CheckBox"
                  Click="OnCropModeMenuClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="10,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Text="파일을 끌어다 놓거나 [파일 &gt; 열기]로 선택하세요." />
        <ProgressBar x:Name="ConvertProgress" Grid.Column="1" Width="120" Minimum="0" Maximum="1"
                     Margin="8,0" VerticalAlignment="Center" IsVisible="False" />
        <Button x:Name="CancelConvertButton" Grid.Column="2" Content="취소" FontSize="12" Padding="10,1"
                IsVisible="False" Click="OnCancelConvertClick" />
      </Grid>
    </Border>

    <Grid RowDefinitions="*,Auto,Auto,Auto">
    <Panel x:Name="DropArea" Margin="12" Background="Transparent" Cursor="Hand"
           PointerPressed="OnDropAreaPressed">
      <Rectangle x:Name="DropBorder" StrokeThickness="2" StrokeDashArray="4,3"
                 Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}"
                 RadiusX="8" RadiusY="8" />

      <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="⬇" FontSize="36" HorizontalAlignment="Center" Opacity="0.5" />
        <TextBlock Text="여기에 파일을 끌어다 놓으세요" HorizontalAlignment="Center" />
        <TextBlock Text="또는 클릭해서 파일 선택" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" />
      </StackPanel>

      <!-- 오디오: 파일 이름 + 파형 (클릭/드래그로 탐색) -->
      <Grid x:Name="AudioPlaceholder" IsVisible="False" Margin="20,16" RowDefinitions="Auto,*">
        <TextBlock x:Name="AudioNameText" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,8" Opacity="0.8" />
        <controls:WaveformView x:Name="WaveformView" Grid.Row="1" MaxHeight="260" VerticalAlignment="Stretch"
                               PlayedBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                               RemainingBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      </Grid>

      <TextBlock x:Name="UnsupportedText" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />

      <!-- 배경과 이미지를 원본 크기로 배치한 뒤 Viewbox가 통째로 확대/축소한다.
           (Border 안에서 Image만 Uniform으로 맞추면 레이아웃 반올림 때문에 가장자리에 1px 틈이 생김) -->
      <Viewbox x:Name="PreviewFrame" IsVisible="False" Margin="12"
               Stretch="Uniform" StretchDirection="DownOnly">
        <Border x:Name="PreviewBackground" Background="{StaticResource CheckerBrush}">
          <Image x:Name="PreviewImage" Stretch="Fill"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
      </Viewbox>

      <!-- 영역 선택 모드에서만 보이는 자르기 레이어 (미리보기 바깥에 겹쳐서 손잡이 크기가 배율과 무관) -->
      <controls:CropOverlay x:Name="CropOverlay" IsVisible="False" />
    </Panel>

    <!-- 동영상 구간 선택용 타임라인 (오디오 트랙이 있으면 파형도 표시) -->
    <controls:WaveformView x:Name="TimelineView" Grid.Row="1" IsVisible="False" Height="44" Margin="12,0,12,6"
                           PlayedBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                           RemainingBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

    <!-- 동영상/오디오 재생 컨트롤 -->
    <Grid x:Name="PlayerBar" Grid.Row="2" IsVisible="False" Margin="12,0,12,8"
          ColumnDefinitions="Auto,Auto,*,Auto">
      <Button x:Name="PlayButton" Click="OnPlayClick" Focusable="False" Padding="10,6"
              ToolTip.Tip="재생 / 일시정지 (Space)">
        <PathIcon x:Name="PlayIcon" Width="12" Height="12" Data="{StaticResource PlayGeometry}" />
      </Button>
      <TextBlock x:Name="TimeText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                 FontSize="12" Text="00:00 / 00:00" />
      <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" Focusable="False"
              VerticalAlignment="Center" Margin="0,-8" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
        <Button x:Name="MuteButton" Click="OnMuteClick" Focusable="False" Padding="8,6"
                ToolTip.Tip="소리 끄기 / 켜기 (M)">
          <PathIcon x:Name="MuteIcon" Width="14" Height="12" Data="{StaticResource VolumeGeometry}" />
        </Button>
        <!-- 0~200%. 100%(원본) 위치에 눈금을 둔다 -->
        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="200" Value="100" Focusable="False"
                Ticks="100" TickPlacement="BottomRight"
                VerticalAlignment="Center" Margin="6,-8,0,-8" ToolTip.Tip="볼륨 0~200% (↑/↓, 100%가 원본)" />
        <TextBlock x:Name="VolumeText" Width="44" Margin="6,0,0,0" VerticalAlignment="Center"
                   FontSize="12" TextAlignment="Right" Text="100%" />
      </StackPanel>
    </Grid>

    <!-- 편집 도구: 기본은 전체 변환. 켠 모드만 적용된다.
         구간 선택 = 오디오·동영상, 영역 선택 = 이미지·동영상 (열린 파일에 맞는 버튼만 보임) -->
    <WrapPanel x:Name="EditBar" Grid.Row="3" IsVisible="False" Margin="12,0,12,8"
               HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="6">
      <ToggleButton x:Name="RangeModeButton" Content="✂ 구간 선택" Focusable="False" Padding="10,4"
                    IsCheckedChanged="OnRangeModeChanged"
                    ToolTip.Tip="켜면 파형/타임라인에서 고른 구간만 저장/변환합니다" />
      <StackPanel x:Name="RangeFields" Orientation="Horizontal" Spacing="6" IsVisible="False">
        <TextBlock Text="시작" VerticalAlignment="Center" />
        <TextBox x:Name="RangeStartBox" Width="88" HorizontalContentAlignment="Center"
                 KeyDown="OnRangeBoxKeyDown" LostFocus="OnRangeBoxLostFocus" />
        <Button x:Name="SetRangeStartButton" Content="[" Focusable="False" Padding="8,4" Click="OnSetRangeStartClick"
                ToolTip.Tip="현재 재생 위치를 시작으로 (I)" />
        <TextBlock Text="끝" VerticalAlignment="Center" Margin="4,0,0,0" />
        <TextBox x:Name="RangeEndBox" Width="88" HorizontalContentAlignment="Center"
                 KeyDown="OnRangeBoxKeyDown" LostFocus="OnRangeBoxLostFocus" />
        <Button x:Name="SetRangeEndButton" Content="]" Focusable="False" Padding="8,4" Click="OnSetRangeEndClick"
                ToolTip.Tip="현재 재생 위치를 끝으로 (O)" />
        <TextBlock x:Name="RangeLengthText" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
      <ToggleButton x:Name="CropModeButton" Content="⬚ 영역 선택" Focusable="False" Padding="10,4"
                    IsCheckedChanged="OnCropModeChanged"
                    ToolTip.Tip="켜면 화면에서 끌어서 고른 영역만 저장/변환합니다" />
      <StackPanel x:Name="CropFields" Orientation="Horizontal" Spacing="6" IsVisible="False">
        <TextBlock Text="X" VerticalAlignment="Center" />
        <NumericUpDown x:Name="CropXBox" Width="70" ShowButtonSpinner="False" FormatString="0" Minimum="0" />
        <TextBlock Text="Y" VerticalAlignment="Center" />
        <NumericUpDown x:Name="CropYBox" Width="70" ShowButtonSpinner="False" FormatString="0" Minimum="0" />
        <TextBlock Text="너비" VerticalAlignment="Center" Margin="4,0,0,0" />
        <NumericUpDown x:Name="CropWidthBox" Width="70" ShowButtonSpinner="False" FormatString="0" Minimum="1" />
        <TextBlock Text="높이" VerticalAlignment="Center" />
        <NumericUpDown x:Name="CropHeightBox" Width="70" ShowButtonSpinner="False" FormatString="0" Minimum="1" />
        <ComboBox x:Name="CropRatioBox" MinWidth="96" Margin="4,0,0,0" ToolTip.Tip="가로:세로 비율 고정"
                  SelectionChanged="OnCropRatioChanged" />
      </StackPanel>
    </WrapPanel>
    </Grid>
  </DockPanel>
</Window>
